# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind

# LLM (leave LLM_API_KEY empty to use the built-in fake LLM for development)
# LLM_PROVIDER: "anthropic" or "openrouter". For OpenRouter use a model id from
# openrouter.ai/models, e.g. LLM_MODEL=openai/gpt-4.1-mini
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Embeddings: "fastembed" (real model) or "fake" (fast, for tests)
EMBEDDING_BACKEND=fastembed
SIMILARITY_THRESHOLD=0.25
# Chunking (used when a document is processed; re-upload documents after changing it)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Used by the Streamlit frontend
API_URL=http://localhost:8000
