# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind

# LLM (leave LLM_API_KEY empty to use the built-in fake LLM for development)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Embeddings: "fastembed" (real model) or "fake" (fast, for tests)
EMBEDDING_BACKEND=fastembed
SIMILARITY_THRESHOLD=0.25

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Used by the Streamlit frontend
API_URL=http://localhost:8000
